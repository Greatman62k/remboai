# Copy to .env and fill in. NEVER commit .env (this repository is public).
DATABASE_URL=postgresql://rembo:rembo@localhost:5432/rembo

# WhatsApp Cloud API (Meta developer dashboard)
WA_APP_SECRET=            # App settings > Basic > App secret; signs every webhook
WA_VERIFY_TOKEN=          # any random string; paste the same value into the webhook settings
WA_ACCESS_TOKEN=          # system-user token (a temporary token expires after about 24 hours)
GRAPH_VERSION=v25.0
