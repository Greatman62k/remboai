# Copy to .env and fill in. NEVER commit .env (this repository is public).
DATABASE_URL=postgresql://rembo:rembo@localhost:5432/rembo
REDIS_URL=redis://localhost:6379/0

# WhatsApp Cloud API (Meta developer dashboard)
WA_APP_SECRET=
WA_VERIFY_TOKEN=
WA_ACCESS_TOKEN=
GRAPH_VERSION=v25.0

# Language model: Meta Model API first. Keep the free-credit warning in mind: while on free credits Meta may use content for product improvement.
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=
LLM_MODEL=muse-spark-1.3
# Reserved for a secondary model if one is added later. No secondary model is configured by default.
# If set, it is tried after the primary model fails; deterministic code fallback remains the final fallback.
# Example: Muse Spark Open on Baseten (use exactly the hackathon model name from your Baseten email):
# LLM_FALLBACK_BASE_URL=https://inference.baseten.co/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=meta-models/muse-spark-open-1026
HOLD_MINUTES=10

# Agent mode: the Meta model runs the receptionist through tools (find_slots, reserve_slot, ...) and code validates every action.
# Off means the keyword/extraction flow answers alone. Check your model host first with: python scripts/probe_tools.py
AGENT_MODE=on
# auto tries native tool calling and falls back to JSON steps for hosts without it; or force tools / json
AGENT_PROTOCOL=auto
AGENT_MAX_STEPS=5
AGENT_CALL_TIMEOUT_S=12
AGENT_TURN_TIMEOUT_S=30
AGENT_REASONING_EFFORT=low
# Optional policy path override. Docker Compose points to the mounted RemboAI policy JSON.
# AGENT_POLICY_PATH=/srv/config/remboai_agent_policy.json
AGENT_RETENTION_DAYS=14
# Sensitive operational data cleanup: resolved/old handoffs, callback bodies
# without pending payments, and raw unmatched-payment payloads.
HANDOFF_RETENTION_DAYS=30
MPESA_CALLBACK_RETENTION_DAYS=90
UNMATCHED_RAW_RETENTION_DAYS=90

# M-Pesa Daraja. Sandbox moves no real money. For real deposits the salon's till needs Safaricom's Go Live approval.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_CALLBACK_SECRET=
MPESA_VERIFY_CALLBACKS=true
PUBLIC_BASE_URL=

# Production only (deploy/docker-compose.prod.yml)
DOMAIN=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Voice notes: Omnilingual ASR on Modal (deploy/modal_asr.py). Leave empty to answer voice notes with "please type".
ASR_URL=
ASR_TOKEN=
ASR_PROXY_KEY=
ASR_PROXY_SECRET=
# Modal cold start is about 90 s; keep this above it so the first note after idle is still transcribed.
ASR_TIMEOUT_S=120

# Photo matching uses the same Meta endpoints as the text model. Set to false to answer photos with "please type".
VISION_ENABLED=true

# Telegram channel (optional, same receptionist, no business verification needed): see docs/TELEGRAM.md
TELEGRAM_BOT_TOKEN=
CENTRAL_WHATSAPP_NUMBER=
TELEGRAM_MODE=auto
TELEGRAM_WEBHOOK_SECRET=

# Daily ceilings on metered calls (0 = no limit). Once reached, Rembo uses its free keyword rules or asks the customer to type.
LLM_DAILY_LIMIT=3000
VISION_DAILY_LIMIT=300
VOICE_DAILY_LIMIT=500
PER_SENDER_DAILY_LIMIT=300
STRIKE_LIMIT=3
MAX_ACTIVE_BOOKINGS=3
# Primary platform administrator sender ID. Add independent backup admin IDs in
# PLATFORM_OWNER_IDS (comma-separated); these identities can access platform controls.
PLATFORM_OWNER_ID=
# Optional comma-separated backup platform administrator IDs.
PLATFORM_OWNER_IDS=

# Abuse and ingress limits
RATE_BURST=10
RATE_WINDOW_S=60
RATE_DAILY=300
LLM_DAILY_PER_SALON=5000
INGRESS_RATE_BURST=120
INGRESS_RATE_GLOBAL=600
INGRESS_RATE_WINDOW_S=60
# Networks allowed to set X-Forwarded-For (comma-separated CIDRs, usually the
# reverse proxy). Behind Caddy or Docker this must cover the proxy, or every
# client shares one rate-limit bucket. Example for the Docker network:
# TRUSTED_PROXY_CIDRS=172.16.0.0/12
TRUSTED_PROXY_CIDRS=

# Logging (stdout + docker json-file rotation; file only if LOG_FILE is set)
LOG_LEVEL=INFO
LOG_FORMAT=text
# LOG_FILE=/tmp/logs/app.log

# Operations and security
OPS_API_KEY=
TOKEN_ENCRYPTION_KEY=
