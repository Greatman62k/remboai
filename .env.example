# Copy to .env and fill in. NEVER commit .env (this repository is public).
DATABASE_URL=postgresql://rembo:rembo@localhost:5432/rembo

# WhatsApp Cloud API (Meta developer dashboard)
WA_APP_SECRET=            # App settings > Basic > App secret; signs every webhook
WA_VERIFY_TOKEN=          # any random string; paste the same value into the webhook settings
WA_ACCESS_TOKEN=          # system-user token (a temporary token expires after about 24 hours)
GRAPH_VERSION=v25.0

# Language model: Meta Model API first. Keep the free-credit warning in mind: while on free credits Meta may use content for product improvement.
LLM_BASE_URL=https://api.meta.ai/v1
LLM_API_KEY=
LLM_MODEL=muse-spark-1.3
# Optional failover: Muse Spark Open on Baseten (use exactly the hackathon model name from your Baseten email)
# LLM_FALLBACK_BASE_URL=https://inference.baseten.co/v1
# LLM_FALLBACK_API_KEY=
# LLM_FALLBACK_MODEL=meta-models/muse-spark-open-1026
HOLD_MINUTES=10

# M-Pesa Daraja. Sandbox moves no real money. For real deposits the salon's till needs Safaricom's Go Live approval.
MPESA_ENV=sandbox                  # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=                     # sandbox: the public test passkey from the portal; production: issued by Safaricom
MPESA_CALLBACK_SECRET=             # random string (openssl rand -hex 24); becomes part of the callback URL
PUBLIC_BASE_URL=                   # https://your-domain, reachable by Safaricom

# Production only (deploy/docker-compose.prod.yml)
DOMAIN=                            # e.g. rembo.example.com, the DNS A record must point at the server
POSTGRES_PASSWORD=                 # openssl rand -hex 24

# Voice notes: Omnilingual ASR on Modal (deploy/modal_asr.py). Leave empty to answer voice notes with "please type".
ASR_URL=                           # https://<workspace>--rembo-asr-asr-web.modal.run/transcribe
ASR_TOKEN=                         # the ASR_TOKEN stored in the Modal secret rembo-asr

# Photo matching uses the same Meta endpoints as the text model. Set to false to answer photos with "please type".
VISION_ENABLED=true
