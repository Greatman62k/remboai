# Copy to deploy/.env.glance-staging on the dedicated staging host and chmod 600.
# Do not copy production credentials into this file. Fill every blank from the
# staging secret manager and the observed packaged WebView origin.
DOMAIN=
STAGING_POSTGRES_PASSWORD=
STAGING_REDIS_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TOKEN_ENCRYPTION_KEY=

GLANCE_ENABLED=true
GLANCE_PAIRING_HMAC_KEYRING=
GLANCE_PAIRING_HMAC_ACTIVE_VERSION=1
GLANCE_SESSION_TTL_SECONDS=604800
GLANCE_EXCHANGE_WINDOW_SECONDS=900
GLANCE_EXCHANGE_SOURCE_LIMIT=12
GLANCE_EXCHANGE_OWNER_LIMIT=10
GLANCE_PAIRING_GENERATION_WINDOW_SECONDS=3600
GLANCE_PAIRING_GENERATION_LIMIT=5
GLANCE_READ_LIMIT_PER_MINUTE=120
GLANCE_WRITE_LIMIT_PER_MINUTE=20
GLANCE_TRANSCRIPTION_LIMIT_PER_MINUTE=6
GLANCE_CORS_ORIGINS=
GLANCE_CORS_WILDCARD_BEARER=false

GLANCE_STAGING_CONFIRM=I_CONFIRM_THIS_IS_ISOLATED_GLANCE_STAGING
GLANCE_STAGING_DATABASE_NAME=remboai_glance_staging
GLANCE_STAGING_DATABASE_HOST=db
GLANCE_STAGING_REDIS_HOST=redis
GLANCE_STAGING_OWNER_CHAT_ID=
